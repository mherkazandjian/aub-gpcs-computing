   "source": [
    "import time\n",
    "\n",
    "N = 10_000_000\n",
    "\n",
    "start = time.time()\n",
    "\n",
    "s = 0\n",
    "for i in range(N + 1):\n",
    "    s += i\n",
    "\n",
    "end = time.time()\n",
    "\n",
    "print(\"Time taken:\", end - start, \"seconds\")"
   ]
  }
